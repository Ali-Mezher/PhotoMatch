PHOTOMATCH_ENV=production
PHOTOMATCH_ADMIN_USERNAME=shop-staff
PHOTOMATCH_ADMIN_PASSWORD=replace-with-a-long-unique-password
PHOTOMATCH_SECRET_KEY=replace-with-at-least-32-random-characters
PHOTOMATCH_SECURE_COOKIE=1
PHOTOMATCH_BACKGROUND_WORKER=1
PHOTOMATCH_COMPUTE_DEVICE=auto
PHOTOMATCH_MODELS_DIR=/app/models
PHOTOMATCH_TRUST_PROXY=0
PHOTOMATCH_ALLOWED_NETWORKS=192.0.2.10/32
PHOTOMATCH_MAX_UPLOAD_MB=12
PHOTOMATCH_EVENT_UPLOAD_MB=500
